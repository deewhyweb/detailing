# Copy to .env and run `node --env-file=.env server.js` to send real email locally.
# On Fly.io the non-secret values live in fly.toml [env]; SMTP_PASS is a Fly secret.
PORT=3000
CONTACT_TO=info@hayes-detailing.com

# Google Workspace SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=adam@hayes-detailing.com
# 16-character Google App Password (requires 2-Step Verification on the account)
SMTP_PASS=
