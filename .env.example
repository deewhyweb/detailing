# Copy to .env and run `node --env-file=.env server.js` to send real email locally.
# On Fly.io the non-secret values live in fly.toml [env]; SMTP_PASS is a Fly secret.
PORT=3000
CONTACT_TO=info@hayes-detailing.com
CONTACT_FROM="Hayes Detailing Website <info@hayes-detailing.com>"

# Resend SMTP (https://resend.com/docs/send-with-smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
# Resend API key (starts with re_)
SMTP_PASS=
